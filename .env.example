# Optional host debugging through a port-forward to a development PostgreSQL pod.
# Normal local development uses make install and the Kubernetes database secret.
# Use sslmode=verify-full for a TLS-enabled database.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=mutexai_browser_platform
POSTGRES_USERNAME=mutexai_browser_platform
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_SSLMODE=disable
LISTEN_ADDR=127.0.0.1:8002
LOG_LEVEL=info

# Required for API/worker startup; the migrate command needs only PostgreSQL.
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_CLIENT_ID=platform-provisioner
KEYCLOAK_CLIENT_SECRET=replace-with-provisioner-client-secret
